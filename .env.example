# Copy this file to .env and put your key there. Never put a real key in this file:
# .env.example is committed to git, .env is not.

# --- LLM provider -------------------------------------------------------------
# auto = Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY is set,
# else offline mode (rule-based engine, no AI model calls).
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_MAX_TOOL_ITERATIONS=8
# Set to false to force offline mode even when a key is present.
LLM_ENABLED=true

# --- Google Gemini (https://aistudio.google.com/apikey) -------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when a model is out of quota or overloaded (each model has its own quota).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-flash-latest

# --- Anthropic Claude (https://console.anthropic.com) ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more thorough, slower, more tokens)
LLM_EFFORT=medium
# Server-side refusal fallback (beta). Disabled automatically if your org lacks access.
LLM_REFUSAL_FALLBACK=true

# --- Data ----------------------------------------------------------------------
# Rebuild data/ecommerce.db from data/raw/*.csv on every start.
REBUILD_DB_ON_START=false
